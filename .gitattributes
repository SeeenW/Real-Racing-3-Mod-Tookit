# Store text with LF in the repository and let the working copy use whatever
# Windows wants.  Without this, every file touched on Windows shows up as a
# whole-file diff the first time it is edited on another machine.
* text=auto eol=lf

# Batch files only work with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.png   binary
*.jpg   binary
*.zip   binary
*.blend binary
*.dds   binary
